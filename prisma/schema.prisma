generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id            String @id @default(uuid())
    userName      String
    email         String @unique
    passwordHash  String
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    notes         Note[]
    refreshTokens RefreshToken[]
}

model Note {
    id            String @id @default(uuid())
    userId        String
    user          User @relation(fields: [userId], references: [id])
    title         String
    content       String
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    @@index([userId])
}

model RefreshToken {
    id            String @id @default(uuid())
    userId        String
    user          User @relation(fields: [userId], references: [id])
    token         String @unique
    expiresAt     DateTime
    createdAt     DateTime  @default(now())

    @@index([userId])
}